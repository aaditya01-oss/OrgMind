# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Free key from console.groq.com
GROQ_API_KEY=CHANGE_ME

# PostgreSQL (with the pgvector extension)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orgmind
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Optional: AI call tracing (free plan at langfuse.com). Leave empty to turn it off.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Must be the same value as "InternalApiKey" in the .NET API settings.
# It stops anyone but the API from calling the AI engine directly.
INTERNAL_API_KEY=CHANGE_ME